---
/**
 * "Meet me offline" (Figma: Desktop / Meet me offline · Full screen).
 * A full-screen photo story: one big photo in the middle, the next and
 * previous ones peeking at the sides, and a caption underneath.
 * Words and pictures live in src/content/offline.ts.
 */
import "../styles/global.css";
import { Image } from "astro:assets";
import Icon from "../components/Icon.astro";
import { offline } from "../content/offline";
import { site } from "../content/site";

const slides = offline.slides;
const total = slides.length;
const pad = (n: number) => String(n).padStart(2, "0");

/** Soft, blurred photos scattered behind everything (Figma "Ghost" layers), as % of the screen */
const ghosts = [
  { img: slides[4].image, x: 2.8, y: 39 },
  { img: slides[0].image, x: 84.7, y: 29.3 },
  { img: slides[5].image, x: 86.1, y: 74.2 },
  { img: slides[0].image, x: 24.3, y: 17.6 },
  { img: slides[3].image, x: 43.1, y: 11.7 },
  { img: slides[1].image, x: 66.7, y: 16.6 },
  { img: slides[1].image, x: 76.4, y: 54.7 },
  { img: slides[5].image, x: 22.2, y: 62.5 },
  { img: slides[4].image, x: 40.3, y: 85.9 },
  { img: slides[3].image, x: 62.5, y: 87.9 },
];
const title = `${offline.tile.title} · ${site.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={offline.tile.summary} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={offline.tile.summary} />
    <meta name="theme-color" content="#fafafa" />
  </head>
  <body>
    <main class="viewer" data-viewer aria-roledescription="carousel" aria-label={offline.tile.title}>
      <h1 class="sr-only">{offline.tile.title}</h1>
      <div class="ghosts" aria-hidden="true">
        {ghosts.map((g) => (
          <Image class="ghost" src={g.img} width={200} alt="" style={`left:${g.x}%;top:${g.y}%`} />
        ))}
      </div>

      <a class="round close" href="/" data-close aria-label="Close and go back to all work">
        <Icon name="close" size={20} />
      </a>
      <div class="controls">
        <p class="counter" aria-live="polite"><span data-current>1</span> / {total}</p>
        <button type="button" class="round" data-dir="-1" aria-label="Previous photo"><Icon name="arrow-left" size={20} /></button>
        <button type="button" class="round" data-dir="1" aria-label="Next photo"><Icon name="arrow-right" size={20} /></button>
      </div>

      <div class="slides">
        {slides.map((s, i) => (
          <button
            type="button"
            class:list={["slide", s.kind]}
            data-slide={i}
            tabindex="-1"
            aria-label={`Show photo ${i + 1}: ${s.title}`}
          >
            <Image
              src={s.image}
              alt={s.alt}
              widths={[480, 760, 1440]}
              sizes="(max-width: 767px) 92vw, 720px"
              loading={i < 2 || i === total - 1 ? "eager" : "lazy"}
            />
          </button>
        ))}
      </div>

      <div class="captions">
        {slides.map((s, i) => (
          <div class="caption" data-caption={i} aria-hidden={i === 0 ? "false" : "true"}>
            <p class="num">{pad(i + 1)}</p>
            <h2 class="title">{s.title}</h2>
            <p class="text">{s.text}</p>
          </div>
        ))}
      </div>
    </main>

    <script>
      const viewer = document.querySelector<HTMLElement>("[data-viewer]")!;
      const slides = Array.from(viewer.querySelectorAll<HTMLElement>("[data-slide]"));
      const captions = Array.from(viewer.querySelectorAll<HTMLElement>("[data-caption]"));
      const current = viewer.querySelector<HTMLElement>("[data-current]")!;
      const n = slides.length;
      let index = 0;

      // Where each photo sits, measured in "big photo widths" from the middle
      // (Figma: neighbours 520px from center, then 300px apart, at 720px wide).
      const place = (instant = false) => {
        slides.forEach((el, i) => {
          let d = i - index;
          if (d > n / 2) d -= n; // wrap around, so 9 sits before 1
          if (d < -n / 2) d += n;
          const a = Math.abs(d);
          const f = a === 0 ? 0 : Math.sign(d) * (0.7222 + (a - 1) * 0.4167);
          el.style.setProperty("--f", String(f));
          el.style.setProperty("--s", a === 0 ? "1" : "0.3611");
          el.style.setProperty("--o", a === 0 ? "1" : a === 1 ? "0.35" : "0");
          el.classList.toggle("is-active", a === 0);
          el.classList.toggle("is-near", a === 1);
          el.classList.toggle("no-anim", instant || a > 2);
        });
        captions.forEach((c, i) => {
          const on = i === index;
          c.classList.toggle("is-active", on);
          c.setAttribute("aria-hidden", on ? "false" : "true");
        });
        current.textContent = String(index + 1);
      };
      const go = (to: number) => {
        index = (to + n) % n;
        place();
      };

      viewer.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((b) =>
        b.addEventListener("click", () => go(index + Number(b.dataset.dir)))
      );
      slides.forEach((el, i) => el.addEventListener("click", () => { if (i !== index) go(i); }));

      // Close: go back to where you came from on this site, else home
      const close = viewer.querySelector<HTMLAnchorElement>("[data-close]")!;
      const leave = () => {
        if (document.referrer && new URL(document.referrer).origin === location.origin && history.length > 1) history.back();
        else location.href = "/";
      };
      close.addEventListener("click", (e) => { e.preventDefault(); leave(); });

      document.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") go(index + 1);
        else if (e.key === "ArrowLeft") go(index - 1);
        else if (e.key === "Escape") leave();
      });

      // Swipe on phones
      let startX = 0, startY = 0, tracking = false;
      viewer.addEventListener("touchstart", (e) => {
        startX = e.touches[0].clientX; startY = e.touches[0].clientY; tracking = true;
      }, { passive: true });
      viewer.addEventListener("touchend", (e) => {
        if (!tracking) return;
        tracking = false;
        const dx = e.changedTouches[0].clientX - startX;
        const dy = e.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(index + (dx < 0 ? 1 : -1));
      }, { passive: true });

      place(true);
      requestAnimationFrame(() => viewer.classList.add("ready"));
    </script>
  </body>
</html>

<style>
  :global(body) { background: #fafafa; }
  .viewer {
    /* Big photo size: 720 x 540 in Figma, shrinking to fit smaller screens */
    --w: min(720px, 62vw, calc((100dvh - 320px) * 4 / 3));
    --h: calc(var(--w) * 0.75);
    /* Middle of the big photo, top to bottom (420 of 1024 in Figma) */
    --cy: max(calc(var(--h) / 2 + 96px), 41dvh);
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: #fafafa;
    color: #181818;
    animation: viewer-in 300ms var(--ease-out) both;
  }
  @keyframes viewer-in { from { opacity: 0; } }

  .ghost {
    position: absolute;
    width: 180px;
    height: 140px;
    object-fit: cover;
    border-radius: 20px;
    opacity: 0.12;
    filter: blur(36px);
  }

  .round {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: #ededed;
    color: #181818;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) {
    .round:hover { background: #e2e2e2; }
  }
  .close { position: absolute; left: 40px; top: 32px; z-index: 3; }
  .controls {
    position: absolute;
    right: 40px;
    top: 32px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .counter {
    margin: 0 8px 0 0;
    font-size: 15px;
    color: #6b6b6b;
    font-variant-numeric: tabular-nums;
  }

  .slide {
    --f: 0;
    --s: 1;
    --o: 1;
    position: absolute;
    left: 50%;
    top: var(--cy);
    width: var(--w);
    height: var(--h);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    opacity: var(--o);
    transform: translate(-50%, -50%) translateX(calc(var(--w) * var(--f))) scale(var(--s));
    transition:
      transform 450ms cubic-bezier(0.42, 0, 0.58, 1),
      opacity 450ms cubic-bezier(0.42, 0, 0.58, 1);
  }
  .slide.no-anim, .viewer:not(.ready) .slide { transition: none; }
  .slide:not(.is-active):not(.is-near) { pointer-events: none; }
  .slide.is-active { cursor: default; z-index: 2; }
  .slide :global(img) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .slide.photo {
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 16px 40px -8px rgba(0, 0, 0, 0.12);
  }
  .slide.photo :global(img) { object-fit: cover; }
  /* Product shots: cut-outs (see-through PNGs) shown whole, with no card */
  .slide.object :global(img) { object-fit: contain; }

  .captions {
    position: absolute;
    left: 50%;
    top: calc(var(--cy) + var(--h) / 2 + 44px);
    width: min(560px, calc(100vw - 48px));
    transform: translateX(-50%);
    display: grid;
    text-align: center;
  }
  .caption {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out);
    pointer-events: none;
  }
  .caption.is-active {
    opacity: 1;
    transform: none;
    transition-delay: 120ms;
    pointer-events: auto;
  }
  .num { margin: 0; font-size: 13px; font-weight: 500; color: #6b6b6b; }
  .title { margin: 10px 0 0; font-size: 32px; font-weight: 500; line-height: 1.2; letter-spacing: -0.01em; }
  .text { margin: 10px 0 0; font-size: 17px; line-height: 28px; color: #4a4a4a; }

  @media (max-width: 767px) {
    .viewer {
      --w: min(calc(100vw - 48px), calc((100dvh - 400px) * 4 / 3));
      --top: calc(32px + env(safe-area-inset-top, 0px));
      --cy: calc(var(--top) + 84px + var(--h) / 2);
    }
    .ghosts { display: none; }
    .close { left: 16px; top: var(--top); }
    .controls { right: 16px; top: var(--top); gap: 8px; }
    .slide.photo { border-radius: 14px; }
    .captions { top: calc(var(--cy) + var(--h) / 2 + 28px); }
    .title { font-size: 24px; }
    .text { font-size: 16px; line-height: 26px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .viewer { animation: none; }
    .slide, .caption { transition: opacity 150ms linear; }
  }
</style>
