---
/** A picture block in a case study, with its caption underneath. */
import { Image } from "astro:assets";
import type { MediaBlock } from "../content/types";
import dotRed from "../assets/opm/dot-red.svg";
import dotYellow from "../assets/opm/dot-yellow.svg";
import dotGreen from "../assets/opm/dot-green.svg";

interface Props { block: MediaBlock }
const { block } = Astro.props;
const { layout, images } = block;
const full = "(max-width: 1023px) calc(100vw - 32px), 880px";
---
<figure class="media-block" data-reveal>
  {layout === "single" && (
    <div data-loader class:list={["card single", { cropped: block.aspect }]} style={block.aspect ? `aspect-ratio: ${block.aspect}` : undefined}>
      <Image src={images[0].src} alt={images[0].alt} widths={[720, 1200, 1760]} sizes={full} />
    </div>
  )}

  {layout === "pair" && (
    <div class="pair" style={[block.aspect && `aspect-ratio:${block.aspect}`, block.gap && `--pair-gap:${block.gap}px`].filter(Boolean).join(";") || undefined}>
      {images.map((img) => (
        <div class="card" data-loader><Image src={img.src} alt={img.alt} widths={[440, 880]} sizes="(max-width: 1023px) 50vw, 432px" /></div>
      ))}
    </div>
  )}

  {layout === "one-big-two-small" && (
    <div class="trio">
      <div data-loader class="card big"><Image src={images[0].src} alt={images[0].alt} widths={[600, 1160]} sizes="(max-width: 1023px) 66vw, 580px" /></div>
      <div class="card" data-loader><Image src={images[1].src} alt={images[1].alt} widths={[300, 570]} sizes="(max-width: 1023px) 33vw, 284px" /></div>
      <div class="card" data-loader><Image src={images[2].src} alt={images[2].alt} widths={[300, 570]} sizes="(max-width: 1023px) 33vw, 284px" /></div>
    </div>
  )}

  {layout === "carousel" && (
    <div class="card carousel" data-loader data-carousel style={block.aspect ? `aspect-ratio: ${block.aspect}` : undefined}>
      <div class="track" tabindex="-1">
        {images.map((img, i) => (
          <div class="slide" aria-roledescription="slide" aria-label={`${i + 1} of ${images.length}`}>
            <Image src={img.src} alt={img.alt} widths={[720, 1200, 1760]} sizes={full} loading="eager" />
          </div>
        ))}
      </div>
      <!-- The arrows and dots are part of the pictures; these invisible buttons sit on top of them -->
      <button class="nav prev" type="button" aria-label="Previous slide" data-dir="-1"></button>
      <button class="nav next" type="button" aria-label="Next slide" data-dir="1"></button>
    </div>
  )}

  {layout === "browser" && (
    <div data-loader class="card browser-stage" style={`background:${block.background ?? "var(--theme-surface)"}`}>
      <div class="browser">
        <div class="chrome">
          <img src={dotRed.src} alt="" width="9" height="9" />
          <img src={dotYellow.src} alt="" width="9" height="9" />
          <img src={dotGreen.src} alt="" width="9" height="9" />
          <span class="url">{block.browserUrl}</span>
        </div>
        <div class="screen">
          <Image src={images[0].src} alt={images[0].alt} widths={[600, 1200]} sizes="(max-width: 1023px) 70vw, 600px" />
        </div>
      </div>
      <div class="overlay-card">
        <Image src={images[1].src} alt={images[1].alt} widths={[280, 560]} sizes="(max-width: 1023px) 32vw, 280px" />
      </div>
    </div>
  )}

  <figcaption class="t-body-l">
    {block.caption.map((p, i) => (
      <p>
        {i === 0 && block.lead && <strong>{block.lead} </strong>}
        <span class="muted">{p}</span>
      </p>
    ))}
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((el) => {
    const track = el.querySelector<HTMLElement>(".track")!;
    const count = track.children.length;
    el.querySelectorAll<HTMLButtonElement>(".nav").forEach((btn) => {
      btn.addEventListener("click", () => {
        const w = track.clientWidth;
        const now = Math.round(track.scrollLeft / w);
        const next = (now + Number(btn.dataset.dir) + count) % count;
        track.scrollTo({ left: next * w, behavior: "smooth" });
      });
    });
  });
</script>

<style>
  .media-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--theme-surface);
  }
  .card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .single :global(img) { height: auto; }
  .single.cropped :global(img) { height: 100%; }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--pair-gap, 16px);
    aspect-ratio: 880 / 377;
  }
  .trio {
    display: grid;
    grid-template-columns: 580fr 284fr;
    grid-template-rows: 1fr 1fr;
    gap: 16px;
    aspect-ratio: 880 / 440;
  }
  .trio .big { grid-row: span 2; }

  .carousel { aspect-ratio: 880 / 560; }
  .track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    outline: none;
  }
  .track::-webkit-scrollbar { display: none; }
  .slide {
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: start;
  }
  .nav {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 14%;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }
  .nav.prev { left: 0; }
  .nav.next { right: 0; }
  .nav:focus-visible { outline-offset: -6px; }

  .browser-stage {
    aspect-ratio: 880 / 560;
    border: 1px solid var(--theme-border);
    container-type: inline-size;
  }
  .browser {
    position: absolute;
    left: 26.25%;
    top: 9.64%;
    width: 68.18%;
    aspect-ratio: 600 / 450;
    background: #fff;
    border-radius: 1.14cqi;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
  .chrome {
    position: relative;
    height: 6.67%;
    background: #f2f2f5;
    display: flex;
    align-items: center;
    gap: 0.57cqi;
    padding-left: 1.36cqi;
  }
  .chrome img { width: 1.02cqi; height: auto; }
  .url {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 25cqi;
    padding: 0.2cqi 0;
    border-radius: 99px;
    background: #fff;
    color: #595961;
    font-size: max(1.14cqi, 6px);
    font-weight: 500;
    text-align: center;
    letter-spacing: 0;
    line-height: 1.4;
  }
  .screen {
    height: 93.33%;
    overflow: hidden;
  }
  .screen :global(img) {
    width: 100%;
    height: auto;
  }
  .overlay-card {
    position: absolute;
    left: 6.25%;
    top: 20%;
    width: 31.82%;
    aspect-ratio: 280 / 374;
    border-radius: 0.9cqi;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
  .overlay-card :global(img) {
    width: 100%;
    height: 103.48%;
    margin-top: -3.48%;
    object-fit: cover;
    object-position: top;
  }

  figcaption {
    max-width: var(--text-max);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  figcaption strong { font-weight: 600; color: var(--theme-text); }

  @media (max-width: 1023px) {
    .pair, .trio { gap: 6.5px; }
    .pair { --pair-gap: 6.5px; }
    .media-block { gap: 16px; }
  }
</style>
