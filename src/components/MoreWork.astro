---
/**
 * Figma "More work · Mixed spans": rows on a 3-column grid, where each piece spans 1, 2 or 3
 * columns and always shows whole. Each tile can open a popup with slides and a caption.
 * Tiles without media show a blurred "Coming soon" picture (desktop only).
 * Phones: wide pieces go full width; the small ones between them pair up in 2 columns.
 * Words and pictures: src/content/more-work.ts
 */
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import type { ImageMetadata } from "astro";
import { moreWork, type Scroll, type MoreWorkItem } from "../content/more-work";

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/more-work/*.{jpg,png}", { eager: true });
const img = (name: string) => {
  const f = files[`../assets/more-work/${name}`];
  if (!f) throw new Error(`More work: missing picture src/assets/more-work/${name}`);
  return f.default;
};

interface Props {
  title: string;
  text: string;
}
const { title, text } = Astro.props;

const FW = 285.333; // Figma tile width
let n = 0;
const rows = moreWork.map((row) =>
  row.map((cell) => ({ span: cell.span, tiles: cell.tiles.map((item) => ({ item, id: `mw-${++n}` })) })),
);
const allTiles = rows.flat().flatMap((c) => c.tiles);

// Picture sizes for a tile that spans 1, 2 or 3 columns (sharp on retina screens)
const sizesFor = (span: number) =>
  span === 1 ? "(max-width: 699px) 50vw, 300px" : `(max-width: 699px) 100vw, ${span === 2 ? 600 : 900}px`;
const widthsFor = (span: number) => (span === 1 ? [300, 600] : span === 2 ? [600, 1200] : [900, 1800]);

// Percent helpers so everything scales with the tile
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(4)}%`;
const scrollStyle = (s: Scroll, w: number, h: number) =>
  `left:${pct(s.window.x, w)};top:${pct(s.window.y, h)};width:${pct(s.window.w, w)};height:${pct(s.window.h, h)};` +
  (s.window.radius ? `border-radius:${((s.window.radius / w) * 100).toFixed(3)}cqi;` : "");
const scrollData = (s: Scroll) =>
  JSON.stringify({ keys: s.keys.map(([t, y]) => [t / s.loop, (y / s.pageHeight) * 100]), loop: s.loop });

const label = (i: MoreWorkItem) => (i.popup ? `${i.title}: ${i.description} Opens a gallery.` : `${i.title}: ${i.description}`);
---
<section class="more-work" aria-labelledby="more-work-title">
  <header class="head" data-reveal>
    <h2 id="more-work-title" class="t-heading">{title}</h2>
    <p class="t-body muted">{text}</p>
  </header>

  <div class="rows">
    {rows.map((row) => (
      <div class="row">
        {row.map((cell) => (
          <div class="cell" data-span={cell.span} style={`--span:${cell.span}`}>
            {cell.tiles.map(({ item, id }) => {
              const ratio = `${item.size[0]} / ${item.size[1]}`;
              const soon = !item.media;
              const Tag = item.popup ? "button" : "div";
              const sizes = sizesFor(cell.span);
              const widths = widthsFor(cell.span);
              return (
                <Tag
                  class:list={["tile", { soon, grow: item.grow, clickable: !!item.popup }]}
                  style={item.grow ? undefined : `aspect-ratio:${ratio}`}
                  data-reveal
                  {...(item.popup ? { type: "button", "data-open": id, "aria-label": label(item) } : {})}
                >
                  {soon && (
                    <>
                      <Image src={img(item.soonImage!)} alt="" widths={[200, 400]} sizes="300px" class="soon-img" />
                      <span class="soon-pill t-small-strong">Coming soon</span>
                    </>
                  )}
                  {item.media?.kind === "image" && (
                    <Image src={img(item.media.src)} alt="" widths={widths} sizes={sizes} quality={90} class="fill" />
                  )}
                  {item.media?.kind === "video" && (
                    <video class="fill" src={item.media.src} poster={item.media.poster} autoplay muted loop playsinline preload="metadata" aria-hidden="true" />
                  )}
                  {item.media?.kind === "cycle" && (
                    <div class="cycle fill" data-cycle={item.media.every}>
                      {item.media.srcs.map((s, i) => (
                        <Image src={img(s)} alt="" widths={widths} sizes={sizes} class="fill" style={i ? "opacity:0" : ""} />
                      ))}
                    </div>
                  )}
                  {item.media?.kind === "scroll" && (
                    <>
                      <Image src={img(item.media.scroll.base)} alt="" widths={widths} sizes={sizes} quality={90} class="fill" />
                      <div class="win" style={scrollStyle(item.media.scroll, FW, (item.size[1] / item.size[0]) * FW)}>
                        <Image src={img(item.media.scroll.page)} alt="" widths={widths} sizes={sizes} class="page" data-scroll={scrollData(item.media.scroll)} />
                      </div>
                    </>
                  )}
                  {(item.popup?.slides.length ?? 0) > 1 && (
                    <span class="dots" aria-hidden="true">
                      {item.popup!.slides.map((_, i) => <i class={i === 0 ? "on" : undefined}></i>)}
                    </span>
                  )}
                  {!soon && (
                    <span class="hover" aria-hidden="true">
                      <span class="t-body-strong">{item.title}</span>
                      <span class="t-small">{item.description}</span>
                    </span>
                  )}
                </Tag>
              );
            })}
          </div>
        ))}
      </div>
    ))}
  </div>
  <div class="phone-list" aria-hidden="true" hidden></div>

  {allTiles.filter(({ item }) => item.popup).map(({ item, id }) => {
    const p = item.popup!;
    const many = p.slides.length > 1;
    return (
      <dialog class="viewer" tabindex="-1" id={id} aria-label={`${p.project}: ${p.title}`}>
        <div class="bar">
          <button class="icon-btn" type="button" data-close aria-label="Close">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          </button>
          {many && (
            <div class="nav">
              <span class="t-small muted counter" aria-live="polite"><span data-current>1</span> / {p.slides.length}</span>
              <button class="icon-btn" type="button" data-prev aria-label="Previous image">
                <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M15 9H3m5-5L3 9l5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <button class="icon-btn" type="button" data-next aria-label="Next image">
                <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 9h12m-5-5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
            </div>
          )}
        </div>
        <div class="body">
          <div class="stage">
            {p.slides.map((s, i) => (
              <figure class:list={["slide", { "is-active": i === 0 }]} data-slide={i} aria-hidden={i === 0 ? "false" : "true"}>
                {s.kind === "image" && (
                  <Image src={img(s.src)} alt={s.alt} widths={[720, 1440]} sizes="(max-width: 799px) 92vw, 720px" loading="lazy" class="slide-media" />
                )}
                {s.kind === "video" && (
                  <div class:list={["slide-media video-wrap", { whole: s.size }]} style={`background:${s.background}${s.size ? `;aspect-ratio:${s.size[0]} / ${s.size[1]}` : ""}`}>
                    <video src={s.src} poster={s.poster} muted loop playsinline preload="none" aria-label={s.alt} />
                  </div>
                )}
                {s.kind === "scroll" && (
                  <div class="slide-media scroll-slide" style={`aspect-ratio:${s.size[0]} / ${s.size[1]}`} role="img" aria-label={s.alt}>
                    {s.scroll.base && <Image src={img(s.scroll.base)} alt="" widths={[720, 1440]} sizes="(max-width: 799px) 92vw, 720px" loading="lazy" class="fill" />}
                    <div class="win" style={scrollStyle(s.scroll, s.size[0], s.size[1])}>
                      <Image src={img(s.scroll.page)} alt="" widths={[720, 1440]} sizes="(max-width: 799px) 92vw, 720px" loading="lazy" class="page" data-scroll={scrollData(s.scroll)} />
                    </div>
                  </div>
                )}
              </figure>
            ))}
          </div>
          <div class="caption">
            <p class="t-small muted project">{p.project}</p>
            <h3 class="t-heading">{p.title}</h3>
            <p class="t-body muted">{p.description}</p>
            {p.link && (
              <a class="t-body ext-link" href={p.link.href} target="_blank" rel="noopener">
                {p.link.label} <Icon name="arrow-up-right" size={18} />
              </a>
            )}
            {p.credits && <p class="t-small muted credits">{p.credits}</p>}
          </div>
        </div>
      </dialog>
    );
  })}
</section>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Phones: wide pieces go full width, and the small tiles between them pair up in two
  // balanced columns. "Coming soon" tiles stay hidden. Wider screens use the rows as built.
  const section = document.querySelector<HTMLElement>(".more-work");
  const rowsEl = section?.querySelector<HTMLElement>(".rows");
  const list = section?.querySelector<HTMLElement>(".phone-list");
  if (section && rowsEl && list) {
    const cells = [...rowsEl.querySelectorAll<HTMLElement>(".cell")];
    const home = cells.map((c) => [...c.children] as HTMLElement[]);
    const height = (t: HTMLElement) => {
      const [w, h] = (t.style.aspectRatio || "1 / 1").split("/").map(Number);
      return h / w;
    };
    const phone = window.matchMedia("(max-width: 699px)");
    const layout = () => {
      if (phone.matches) {
        let pair: HTMLElement[] | null = null;
        const h = [0, 0];
        cells.forEach((cell, i) => {
          const wide = Number(cell.dataset.span) > 1;
          for (const t of home[i]) {
            if (t.classList.contains("soon")) continue;
            if (wide) {
              list.append(t);
              pair = null;
              continue;
            }
            if (!pair) {
              const p = document.createElement("div");
              p.className = "pair";
              pair = [document.createElement("div"), document.createElement("div")];
              pair.forEach((c) => (c.className = "pair-col"));
              p.append(...pair);
              list.append(p);
              h[0] = h[1] = 0;
            }
            const k = h[0] <= h[1] ? 0 : 1;
            pair[k].append(t);
            h[k] += height(t);
          }
        });
        list.hidden = false;
        list.removeAttribute("aria-hidden");
        rowsEl.hidden = true;
      } else {
        home.forEach((tiles, i) => cells[i].append(...tiles));
        list.replaceChildren();
        list.hidden = true;
        rowsEl.hidden = false;
      }
    };
    layout();
    phone.addEventListener("change", layout);
  }

  // Scrolling pages (tiles and popups)
  const startScroll = (el: HTMLElement) => {
    if (el.dataset.started || reduce) return;
    el.dataset.started = "1";
    const { keys, loop } = JSON.parse(el.dataset.scroll!) as { keys: [number, number][]; loop: number };
    const frames: Keyframe[] = [{ offset: 0, transform: "translateY(0)" }];
    for (const [o, y] of keys) frames.push({ offset: Math.min(o, 1), transform: `translateY(${y}%)`, easing: "ease-in-out" });
    frames.push({ offset: 1, transform: "translateY(0)" });
    el.animate(frames, { duration: loop * 1000, iterations: Infinity });
  };
  document.querySelectorAll<HTMLElement>(".more-work .tile [data-scroll]").forEach(startScroll);

  // Fast flip through pictures (Acura)
  document.querySelectorAll<HTMLElement>(".more-work [data-cycle]").forEach((el) => {
    if (reduce) return;
    const imgs = [...el.querySelectorAll("img")];
    const every = parseFloat(el.dataset.cycle!) * 1000;
    // The tile's dots stay still (Jordan found them moving distracting)
    let i = 0;
    setInterval(() => {
      imgs[i].style.opacity = "0";
      i = (i + 1) % imgs.length;
      imgs[i].style.opacity = "1";
    }, every);
  });

  // Popups
  document.querySelectorAll<HTMLButtonElement>(".more-work [data-open]").forEach((btn) => {
    const dlg = document.getElementById(btn.dataset.open!) as HTMLDialogElement;
    const slides = [...dlg.querySelectorAll<HTMLElement>("[data-slide]")];
    const current = dlg.querySelector("[data-current]");
    let at = 0;
    // Like Meet me offline: the current picture in the middle, the ones before and after
    // peeking in small at the sides (Figma: 520px from center at 720 wide, 36% size).
    const n = slides.length;
    const show = (to: number, instant = false) => {
      at = (to + n) % n;
      slides.forEach((s, i) => {
        let d = i - at;
        if (d > n / 2) d -= n;
        if (d < -n / 2) d += n;
        if (n === 2 && d !== 0) d = 1; // with two pictures, the other one waits on the right
        const a = Math.abs(d);
        s.style.setProperty("--f", String(a === 0 ? 0 : Math.sign(d) * (0.7222 + (a - 1) * 0.4167)));
        s.style.setProperty("--s", a === 0 ? "1" : "0.3611");
        s.style.setProperty("--o", a === 0 ? "1" : a === 1 ? "0.35" : "0");
        s.classList.toggle("is-active", a === 0);
        s.classList.toggle("is-near", a === 1);
        s.classList.toggle("no-anim", instant || a > 2);
        s.setAttribute("aria-hidden", a === 0 ? "false" : "true");
        const v = s.querySelector("video");
        if (v) a === 0 ? v.play().catch(() => {}) : v.pause();
      });
      slides[at].querySelectorAll<HTMLElement>("[data-scroll]").forEach(startScroll);
      if (current) current.textContent = String(at + 1);
    };
    btn.addEventListener("click", () => {
      dlg.showModal();
      dlg.scrollTop = 0;
      // Focus the popup itself so the close button doesn't show a focus ring on open
      dlg.focus();
      document.documentElement.classList.add("no-scroll");
      show(0, true);
    });
    slides.forEach((s, i) => s.addEventListener("click", () => { if (i !== at) show(i); }));
    dlg.querySelector("[data-close]")?.addEventListener("click", () => dlg.close());
    dlg.querySelector("[data-prev]")?.addEventListener("click", () => show(at - 1));
    dlg.querySelector("[data-next]")?.addEventListener("click", () => show(at + 1));
    dlg.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(at - 1);
      if (e.key === "ArrowRight") show(at + 1);
    });
    // Phones: swipe left or right anywhere in the popup to change pictures
    if (slides.length > 1) {
      let x0 = 0, y0 = 0, t0 = 0;
      dlg.addEventListener("touchstart", (e) => {
        x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; t0 = Date.now();
      }, { passive: true });
      dlg.addEventListener("touchend", (e) => {
        const dx = e.changedTouches[0].clientX - x0;
        const dy = e.changedTouches[0].clientY - y0;
        const fast = Date.now() - t0 < 600;
        if (Math.abs(dx) > Math.abs(dy) * 1.2 && (Math.abs(dx) > 60 || (fast && Math.abs(dx) > 30))) {
          show(dx < 0 ? at + 1 : at - 1);
        }
      }, { passive: true });
    }
    // Click on the empty background closes it
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg || (e.target as HTMLElement).classList.contains("body")) dlg.close();
    });
    dlg.addEventListener("close", () => {
      document.documentElement.classList.remove("no-scroll");
      dlg.querySelectorAll("video").forEach((v) => v.pause());
    });
  });
</script>

<style>
  .more-work {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 560px;
  }

  /* ---------- Grid ---------- */
  .rows {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  /* A cell spans 1, 2 or 3 columns and stacks its tiles. Cells in a row share one height,
     so a lone tile stretches a hair if its neighbor's stack is a pixel taller. */
  .cell {
    grid-column: span var(--span);
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .cell > .tile:only-child { flex: 1 0 auto; }
  /* "Coming soon" fills whatever is left of its stack */
  .tile.grow {
    flex: 1 1 0;
    min-height: 64px;
  }
  .rows[hidden], .phone-list[hidden] { display: none; }
  .phone-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .phone-list :global(.pair) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    align-items: start;
  }
  .phone-list :global(.pair-col) {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (max-width: 699px) {
    /* Without the script: one column, everything full width */
    .row { grid-template-columns: 1fr; gap: 12px; }
    .rows, .cell { gap: 12px; }
    .cell { grid-column: auto; }
    .soon { display: none; }
  }

  .tile {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 12px;
    overflow: hidden;
    isolation: isolate;
    background: var(--theme-surface);
    container-type: inline-size;
    font: inherit;
    color: inherit;
    text-align: left;
    transition: transform 450ms var(--ease-out), box-shadow 450ms var(--ease-out);
  }
  .tile.clickable { cursor: pointer; }
  .fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .tile > video.fill { transform: scale(1.01); }

  .win {
    position: absolute;
    overflow: hidden;
    background: #fff;
  }
  .win :global(.page) {
    display: block;
    width: 100%;
    height: auto;
    will-change: transform;
  }

  .cycle :global(img) { transition: none; }

  .dots {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: flex;
    gap: 4px;
    align-items: center;
    padding: 6px 8px;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
    z-index: 1;
  }
  .dots i {
    flex: none;
    transition: width 150ms ease, background 150ms ease;
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.55);
  }
  .dots i.on {
    width: 14px;
    background: #fff;
  }

  /* Hover: dark gradient with the name and one line */
  .hover {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2px;
    padding: 16px;
    color: #fff;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 35%, rgba(0, 0, 0, 0.45) 60%, rgba(0, 0, 0, 0.7) 82%, rgba(0, 0, 0, 0.92) 100%);
    opacity: 0;
    transition: opacity var(--dur-med) var(--ease-out);
  }
  .hover .t-small { opacity: 0.85; }
  @media (hover: hover) {
    .tile:not(.soon):hover .hover,
    .tile:focus-visible .hover { opacity: 1; }
    .tile.clickable:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
    }
  }

  /* Coming soon: blurred picture and a small label */
  .soon :global(.soon-img) {
    position: absolute;
    inset: -20%;
    width: 140%;
    height: 140%;
    object-fit: cover;
    filter: blur(22px) saturate(1.1);
    opacity: 0.85;
  }
  .soon-pill {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(8px);
    color: var(--theme-text);
    white-space: nowrap;
  }

  /* ---------- Popup ---------- */
  .viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #fafafa;
    color: var(--theme-text);
  }
  .viewer::backdrop { background: rgba(250, 250, 250, 0.9); }
  .viewer[open] {
    display: flex;
    flex-direction: column;
    /* The whole popup scrolls, so pictures slide up under the buttons instead of being cut off */
    overflow-y: auto;
    overflow-x: hidden;
    animation: viewer-in 300ms var(--ease-out);
  }
  @keyframes viewer-in {
    from { opacity: 0; transform: translateY(8px); }
  }
  .bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 32px;
    pointer-events: none;
  }
  .bar > * { pointer-events: auto; }
  .nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .counter { margin-right: 4px; font-variant-numeric: tabular-nums; }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 99px;
    background: #ececea;
    color: var(--theme-text);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .icon-btn:hover { background: #e2e2df; }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
    padding: 48px 24px 64px;
    overflow-x: clip;
  }
  .stage {
    width: min(720px, 100%);
    display: grid;
    align-items: start; /* every picture starts at the same height */
  }
  /* All pictures share one spot; the script slides the others out to the sides */
  .slide {
    --f: 0;
    --s: 1;
    --o: 1;
    grid-area: 1 / 1;
    margin: 0;
    opacity: var(--o);
    transform: translateX(calc(var(--f) * 100%)) scale(var(--s));
    transition:
      transform 450ms cubic-bezier(0.42, 0, 0.58, 1),
      opacity 450ms cubic-bezier(0.42, 0, 0.58, 1);
  }
  .slide:not(.is-active) { cursor: pointer; }
  .slide:not(.is-active):not(.is-near) { pointer-events: none; }
  .slide.is-active { z-index: 1; }
  .slide.no-anim { transition: none; }
  .viewer { touch-action: pan-y; }
  .viewer:focus { outline: none; }
  .icon-btn:focus:not(:focus-visible) { outline: none; }
  .slide :global(.slide-media) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 16px 40px -8px rgba(0, 0, 0, 0.12);
  }
  .scroll-slide {
    position: relative;
    container-type: inline-size;
    background: #fff;
  }
  .video-wrap {
