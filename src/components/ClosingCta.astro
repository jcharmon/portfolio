---
/** Figma "Case study / Closing CTA". Sits at the end of every case study. */
import Button from "./Button.astro";
import { site } from "../content/site";
interface Props {
  title?: string;
  text?: string;
}
const {
  title = "This is just a snapshot.",
  text = "I’d love to walk you through the full story, from early research to what shipped.",
} = Astro.props;
---
<section class="cta">
  <div class="text">
    <h2 class="t-heading">{title}</h2>
    <p class="t-body muted">{text}</p>
  </div>
  <div class="actions">
    <Button href={site.email} arrow external>Reach out</Button>
    <Button href="/" variant="secondary">See all work</Button>
  </div>
</section>

<style>
  .cta {
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 40px 48px;
    border-radius: 24px;
    background: var(--theme-surface);
  }
  .text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .text p {
    max-width: 435px;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  @media (max-width: 1279px) {
    .cta {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      padding: 28px 24px;
    }
  }
</style>
