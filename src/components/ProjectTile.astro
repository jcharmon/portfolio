---
/** Figma "Tile / Work": image, then project name and one-line summary. Hover dims the image. */
import Icon from "./Icon.astro";
import TileMedia from "./TileMedia.astro";
import type { Project } from "../content/projects";

/**
 * Pass a project, or (for a tile that isn't a case study) a title, summary, href
 * and the tile picture as children.
 */
interface Props {
  project?: Project;
  title?: string;
  summary?: string;
  href?: string;
  /** Darken the picture on hover (default true) */
  dim?: boolean;
  /** Load the picture right away (for tiles at the top of the page) */
  eager?: boolean;
}
const { project } = Astro.props;
const title = project?.title ?? Astro.props.title;
const summary = project?.summary ?? Astro.props.summary;
const href = project ? (project.ready ? `/work/${project.slug}` : undefined) : Astro.props.href;
const Tag = href ? "a" : "div";
const dim = Astro.props.dim ?? true;
---
<Tag data-reveal class:list={["tile", { link: !!href }]} {...(href ? { href } : {})}>
  <div class="box" data-loader>
    {project ? <TileMedia slug={project.slug} eager={Astro.props.eager} /> : <slot />}
    {dim && <div class="hover-dim" aria-hidden="true"></div>}
    <div class="edge" aria-hidden="true"></div>
  </div>
  <div class="caption">
    <p class="title t-body-strong">
      <span>{title}</span>
      {href && <Icon name="arrow-up-right" size={20} class="arrow" />}
    </p>
    <p class="t-body muted">{summary}</p>
  </div>
</Tag>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
    color: inherit;
  }
  .box {
    position: relative;
    aspect-ratio: 416 / 312;
    border-radius: var(--radius-tile);
    overflow: hidden;
    isolation: isolate;
    /* Hover lift: the card rises a few pixels and casts a soft shadow */
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    transition:
      transform 450ms var(--ease-out),
      box-shadow 450ms var(--ease-out);
  }
  /* Light border on top of the picture, so white edges don't melt into the page.
     (A real element, not ::after, because ::after is the loading shimmer.) */
  .edge {
    position: absolute;
    inset: 0;
    /* See-through black reads on white edges and on photos alike */
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: inherit;
    pointer-events: none;
    z-index: 2;
  }
  :global(.js) .box:not(.is-loaded) > .edge { opacity: 1; }

  /* Loading: soft shimmer (global), then the picture fades in while it
     settles from slightly zoomed and soft to sharp. */
  :global(.js) .box > :global(:first-child) {
    transition:
      opacity 600ms var(--ease-out),
      filter 700ms var(--ease-out),
      transform 900ms var(--ease-out);
  }
  :global(.js) .box:not(.is-loaded) > :global(:first-child) {
    transform: scale(1.04);
    filter: blur(6px);
  }
  .hover-dim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.12);
    opacity: 0;
    transition: opacity var(--dur-med) var(--ease-out);
  }
  .caption {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .title :global(.arrow) {
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity var(--dur-fast), transform var(--dur-med) var(--ease-out);
  }
  .soon {
    position: absolute;
    left: 12px;
    top: 12px;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.92);
    color: #181818;
  }
  @media (hover: hover) {
    .link:hover .hover-dim { opacity: 1; }
    .link:hover .box {
      transform: translateY(-6px);
      box-shadow: 0 14px 28px -12px rgba(0, 0, 0, 0.22);
    }
    .link:hover .box > :global(:first-child) { transform: scale(1.025); }
    .link:hover .title :global(.arrow) { opacity: 1; transform: none; }
  }
  .link:focus-visible .title :global(.arrow) { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .link:hover .box,
    .link:hover .box > :global(:first-child) { transform: none; }
    :global(.js) .box:not(.is-loaded) > :global(:first-child) { transform: none; filter: none; }
  }
  @media (max-width: 1023px) {
    .box { aspect-ratio: 4 / 3; }
  }
</style>
