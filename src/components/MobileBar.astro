---
/**
 * Figma "Mobile / Top bar" and "Mobile / Back bar". Only shows on phones and
 * small tablets. Stays stuck to the top while you scroll.
 */
import Smiley from "./Smiley.astro";
import TextLink from "./TextLink.astro";
import Icon from "./Icon.astro";
import { site } from "../content/site";

interface Props { variant: "top" | "back" }
const { variant } = Astro.props;
---
<header class:list={["mobile-bar", variant]}>
  {variant === "top" ? (
    <>
      <Smiley />
      <nav class="links" aria-label="Contact">
        <TextLink href={site.email} external>Reach out</TextLink>
        <TextLink href={site.resume} external>Resume</TextLink>
      </nav>
    </>
  ) : (
    <a class="back t-body" href="/">
      <Icon name="arrow-left" size={20} />
      All work
    </a>
  )}
</header>

<script>
  /*
   * Home page on phones: the bar's "Reach out" and "Resume" links stay hidden
   * while the same links in the intro are on screen, then slide in once you
   * scroll past them (and slide away again if you scroll back up).
   */
  const bar = document.querySelector<HTMLElement>(".mobile-bar.top");
  const trigger = document.querySelector<HTMLElement>("[data-bar-trigger]");
  if (bar && trigger && "IntersectionObserver" in window) {
    bar.classList.add("links-hidden");
    new IntersectionObserver(
      ([entry]) => {
        const passed = !entry.isIntersecting && entry.boundingClientRect.top < 56;
        bar.classList.toggle("links-hidden", !passed);
      },
      { rootMargin: "-56px 0px 0px 0px" }
    ).observe(trigger);
  }
</script>

<style>
  .mobile-bar {
    display: none;
  }
  @media (max-width: 1023px) {
    .mobile-bar {
      position: sticky;
      top: 0;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
      padding: 0 var(--gutter);
      background: color-mix(in srgb, var(--theme-bg) 92%, transparent);
      backdrop-filter: saturate(1.4) blur(12px);
      -webkit-backdrop-filter: saturate(1.4) blur(12px);
    }
  }
  .links {
    display: flex;
    gap: 24px;
  }

  /* Slide-in for the home page links (phones only, since the bar is phones only) */
  .mobile-bar.top {
    box-shadow: 0 1px 0 transparent;
    transition: box-shadow 300ms var(--ease-out);
  }
  .mobile-bar.top:not(.links-hidden) { box-shadow: 0 1px 0 var(--theme-border); }
  .top .links > :global(*) {
    transition:
      opacity 420ms var(--ease-out),
      transform 520ms cubic-bezier(0.3, 1.35, 0.5, 1),
      filter 420ms var(--ease-out);
  }
  .top .links > :global(*:nth-child(2)) { transition-delay: 70ms; }
  .top.links-hidden .links > :global(*) {
    opacity: 0;
    transform: translateY(-10px);
    filter: blur(4px);
    pointer-events: none;
    transition-duration: 220ms;
    transition-delay: 0ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .top .links > :global(*) { transform: none !important; filter: none !important; }
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--theme-text);
    text-decoration: none;
  }
</style>
