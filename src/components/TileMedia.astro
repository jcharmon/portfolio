---
/**
 * The picture inside each home-page tile.
 * Each one is a single image exported from Figma at 3x
 * (page "Website", Components section, "Media / <Project> · E1 tile").
 * To swap a picture: export the new one from Figma at 3x as JPG and
 * replace the file in src/assets/home/ with the same name.
 */
import { Image } from "astro:assets";
import type { ProjectSlug } from "../content/projects";

import opm from "../assets/home/tile-opm.jpg";
import thrive from "../assets/home/tile-thrive.jpg";
import bobbie from "../assets/home/tile-bobbie.jpg";
import nextnav from "../assets/home/tile-nextnav.jpg";
import radpad from "../assets/home/tile-radpad.jpg";
import googleFi from "../assets/home/tile-google-fi.jpg";

/**
 * zoom: the tile starts zoomed in on its top-left corner and zooms out on hover
 * to show the whole board (Thrive). The number is how far it's zoomed in.
 */
const tiles: Record<ProjectSlug, { src: ImageMetadata; alt: string; zoom?: number }> = {
  opm: { src: opm, alt: "OPM logo over a records room, with the new insurance elections screen in a browser" },
  thrive: {
    src: thrive,
    alt: "Thrive Mobile brand board: the My plan screen, the Thrive app icon on a home screen, the Thrive Guide AI chat, the logo, an ad and app icons",
    zoom: 1.4,
  },
  bobbie: { src: bobbie, alt: "Bobbie logo over a mother feeding her baby, with the Bobbie order screen on a phone" },
  "google-fi": { src: googleFi, alt: "Google Fi logo over a man laughing on a call, with the Google Fi app on a phone and the sign-up page in a browser" },
  nextnav: { src: nextnav, alt: "NextNav logo over a city at night, with the NextNav map on a phone" },
  radpad: { src: radpad, alt: "RadPad logo over a sunny living room, with the lease signing screen in a browser" },
};

interface Props { slug: ProjectSlug; eager?: boolean }
const { slug, eager = false } = Astro.props;
const tile = tiles[slug];
// Tile is 416px wide on desktop and up to the full screen width on phones
// A zoomed tile shows part of the picture larger, so it needs a sharper file
const widths = tile.zoom ? [832, 1248, 1664] : [480, 832, 1248];
const sizes = tile.zoom ? `(max-width: 1023px) ${Math.round(100 * tile.zoom)}vw, ${Math.round(416 * tile.zoom)}px` : "(max-width: 1023px) 100vw, 416px";
---
<div class:list={["media", slug, { zoom: tile.zoom }]} style={tile.zoom ? `--zoom: ${tile.zoom}` : undefined}>
  <Image class="bg" src={tile.src} widths={widths} sizes={sizes} alt={tile.alt} quality={92} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} />
</div>

<style>
  .media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    container-type: inline-size;
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Zoomed tile: starts on the top-left of the board, zooms out on hover */
  .zoom .bg {
    transform: scale(var(--zoom));
    transform-origin: 0 0;
    transition: transform 900ms var(--ease-out);
  }
  @media (hover: hover) {
    :global(.link:hover) .zoom .bg,
    :global(.link:focus-visible) .zoom .bg { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .zoom .bg { transition: none; }
  }
</style>
